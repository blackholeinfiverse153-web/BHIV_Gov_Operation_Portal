# Copy to `.env` and fill in. DO NOT COMMIT `.env`.

# gov-ops is MOUNTED INSIDE AIAIC, so the base URL must end in /gov-ops.
# Verified 2026-09-24:  <host>:8017/gov-ops/health -> 200   |   <host>:8017/api/requests -> 404
# Running gov-ops on its own instead (`python -m gov_ops`) it is http://localhost:8090 with no suffix.
VITE_API_BASE_URL=https://<your-tunnel>.ngrok-free.dev/gov-ops

# Required whenever the deployment sets GOV_OPS_API_KEY. Ask Hemanth for the value.
# Compiled into the browser bundle - a lock on the door, not a login.
VITE_GOV_OPS_API_KEY=

# The AQIAIC plant service (used by src/services/aqiaicPlant.ts).
VITE_AQIAIC_BASE_URL=http://127.0.0.1:8000
